{
  "name": "Pizza Pizza QSR Phone Agent",
  "type": "inbound",
  "assistant": {
    "model": {
      "provider": "openai",
      "model": "gpt-4-turbo",
      "temperature": 0.7,
      "max_tokens": 500,
      "system_prompt": "You are Emma, a friendly and efficient phone assistant for Pizza Pizza. Your job is to take orders accurately, suggest popular add-ons, and ensure customers have a great experience. Always confirm orders before submitting. Be warm but professional. Keep responses concise since this is a phone call."
    },
    "voice": {
      "provider": "11labs",
      "voice_id": "21m00Tcm4TlvDq8ikWAM",
      "stability": 0.8,
      "similarity_boost": 0.75,
      "speed": 1.0,
      "optimize_streaming_latency": 3
    },
    "transcriber": {
      "provider": "deepgram",
      "model": "nova-2",
      "language": "en-US",
      "keywords": [
        "pepperoni:5",
        "pickup:3",
        "delivery:3",
        "large:2",
        "medium:2"
      ],
      "smart_format": true,
      "profanity_filter": false,
      "punctuate": true,
      "redact": [
        "pci",
        "ssn"
      ]
    },
    "first_message": "Thanks for calling Pizza Pizza, this is Emma. Are we starting a new order for pickup or delivery today?",
    "max_duration_seconds": 600,
    "silence_timeout_seconds": 30,
    "response_delay_seconds": 0.4,
    "interruptions_enabled": true,
    "background_sound": "office",
    "backchannel_enabled": true,
    "backchannel_words": [
      "mhm",
      "yeah",
      "okay"
    ]
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "Tool_POS_Check",
        "description": "Query the POS system to check menu prices, item availability, and out-of-stock items. Use this before confirming any order items to ensure they're available and get current pricing.",
        "parameters": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "get_menu",
                "check_stock",
                "validate_item"
              ],
              "description": "The type of check to perform"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sku": {
                    "type": "string",
                    "description": "Product SKU code"
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "Quantity to validate"
                  }
                }
              },
              "description": "Array of items to validate"
            }
          },
          "required": [
            "action"
          ]
        }
      },
      "server": {
        "url": "https://api.yourrestaurant.com/v1/pos",
        "timeout_seconds": 2
      }
    },
    {
      "type": "function",
      "function": {
        "name": "Tool_Customer_Lookup",
        "description": "Look up customer information by phone number to retrieve order history, addresses, and 'The Usual' preferences. Use this at the start of calls to personalize the experience.",
        "parameters": {
          "type": "object",
          "properties": {
            "phone": {
              "type": "string",
              "description": "Phone number in E.164 format (e.g., +15551234567)"
            },
            "include_history": {
              "type": "boolean",
              "description": "Whether to include order history",
              "default": true
            }
          },
          "required": [
            "phone"
          ]
        }
      },
      "server": {
        "url": "https://api.yourrestaurant.com/v1/customers",
        "timeout_seconds": 1.5
      }
    },
    {
      "type": "function",
      "function": {
        "name": "Tool_Order_Submit",
        "description": "Submit the finalized order to the POS Kitchen Display System. Only use this after the customer has confirmed the complete order and pricing.",
        "parameters": {
          "type": "object",
          "properties": {
            "order_payload": {
              "type": "object",
              "description": "Complete order object with customer, items, fulfillment, and payment details"
            }
          },
          "required": [
            "order_payload"
          ]
        }
      },
      "server": {
        "url": "https://api.yourrestaurant.com/v1/orders",
        "timeout_seconds": 3
      }
    },
    {
      "type": "function",
      "function": {
        "name": "Tool_Address_Validation",
        "description": "Validate a delivery address to check if it's in the delivery zone and calculate delivery fee and estimated time.",
        "parameters": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "description": "Full street address"
            },
            "postal_code": {
              "type": "string",
              "description": "Postal/ZIP code"
            }
          },
          "required": [
            "address"
          ]
        }
      },
      "server": {
        "url": "https://api.yourrestaurant.com/v1/delivery/zones",
        "timeout_seconds": 2
      }
    },
    {
      "type": "function",
      "function": {
        "name": "Tool_Human_Handoff",
        "description": "Transfer the call to a human staff member. Use this for complaints, complex questions, or when the customer explicitly requests to speak with someone.",
        "parameters": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "complaint",
                "complex_question",
                "payment_issue",
                "customer_request"
              ],
              "description": "Reason for handoff"
            },
            "context": {
              "type": "string",
              "description": "Brief summary of the conversation to brief the human agent"
            }
          },
          "required": [
            "reason",
            "context"
          ]
        }
      },
      "async": true
    }
  ],
  "end_call_phrases": [
    "thanks bye",
    "goodbye",
    "that's all",
    "cancel order"
  ],
  "server_messages": [
    "conversation-update",
    "function-call",
    "hang",
    "speech-update",
    "status-update",
    "transcript",
    "tool-calls"
  ],
  "client_messages": [
    "conversation-update",
    "transcript"
  ]
}
